# Copy this file to deploy/ui.runtime.env and set real values for your environment.
# In this deployment mode, NEXT_PUBLIC_* endpoint values should also be provided
# so server-side runtime config does not fall back to localhost defaults.

HASURA_ADMIN_SECRET=replace-me
NEXTAUTH_URL=https://ui.example.com
NEXTAUTH_SECRET=replace-me
ADMIN_PASSWORD=replace-me
ALLOW_IMAGE_UPLOAD=false
NEXT_PUBLIC_API_URL=https://hasura.example.com/v1/graphql
NEXT_PUBLIC_WS_URL=wss://hasura.example.com/v1/graphql
NEXT_PUBLIC_CITRINE_CORE_URL=https://core.example.com
NEXT_PUBLIC_FILE_SERVER_URL=https://files.example.com
NEXT_PUBLIC_BANNER_MESSAGE=OCPP 2.1 Now Available!
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LATITUDE=39.833333
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LONGITUDE=-98.583333
